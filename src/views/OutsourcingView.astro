---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import { alt, routes, type Locale } from "../i18n/locales";
import { getCopy } from "../copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getCopy(locale);
const o = c.outsourcing;
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout locale={locale} alternates={alt("outsourcing")} title={o.title} description={o.description} current="services">
  <PageHero
    photo="warehouse"
    locale={locale}
    eyebrow={o.hero.eyebrow}
    title={o.hero.title}
    lead={o.hero.lead}
    crumbLabel={c.ui.breadcrumb}
    crumbs={[
      { label: "Integrade", href: routes.home[locale] },
      { label: "Services", href: routes.services[locale] },
      { label: o.title },
    ]}
  >
    <Fragment slot="actions">
      <a class="btn btn--gold" href={`${routes.contact[locale]}?need=outsourcing`}>{o.hero.primary}<span aria-hidden="true">→</span></a>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="wrap when">
      <div>
        <p class="eyebrow">{o.when.eyebrow}</p>
        <h2 class="h2">{o.when.title}</h2>
      </div>
      <ul class="when__list">
        {o.when.items.map((it, i) => (
          <li><span>{pad(i + 1)}</span>{it}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--pale">
    <div class="wrap">
      <SectionHead eyebrow={o.scope.eyebrow} title={o.scope.title} stacked />
      <ol class="rule-list">
        {o.scope.items.map((it, i) => (
          <li>
            <span class="rule-list__no">{pad(i + 1)}</span>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ol>
      <p class="note mt-l">{o.note}</p>
    </div>
  </section>

  <CtaBand locale={locale} need="outsourcing" />
</BaseLayout>

<style>
  .when {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
  }

  .when__list {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .when__list li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(17px, 1.4vw, 20px);
    font-weight: 300;
    color: var(--ink);
  }

  .when__list span {
    font-size: 13px;
    font-weight: 650;
    color: var(--teal-600);
    padding-top: 4px;
  }

  @media (max-width: 860px) {
    .when {
      grid-template-columns: 1fr;
    }
  }
</style>
