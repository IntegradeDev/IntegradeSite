---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import ModuleExplorer from "../components/ModuleExplorer.astro";
import LifecycleExplorer from "../components/LifecycleExplorer.astro";
import CtaBand from "../components/CtaBand.astro";
import { alt, routes, modulePath, type Locale } from "../i18n/locales";
import { getCopy } from "../copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getCopy(locale);
const o = c.integradeOne;
const mods = c.modules.items;
const contactSoftware = `${routes.contact[locale]}?need=software&origin=Integrade%20One`;
---

<BaseLayout locale={locale} alternates={alt("integradeOne")} title={o.title} description={o.description} current="one">
  <section class="one-hero">
    <div class="wrap">
      <nav aria-label={c.ui.breadcrumb}>
        <ol class="breadcrumbs">
          <li><a href={routes.home[locale]}>Integrade</a></li>
          <li><a href={routes.solutions[locale]}>Solutions</a></li>
          <li><span aria-current="page">Integrade One</span></li>
        </ol>
      </nav>
      <div class="one-hero__grid">
        <div>
          <p class="eyebrow">{o.hero.eyebrow}</p>
          <h1 class="display" set:html={o.hero.titleHtml} />
          <p class="lead">{o.hero.lead}</p>
          <div class="actions">
            <a class="btn btn--gold" href={contactSoftware}>{o.hero.primary}<span aria-hidden="true">→</span></a>
            <a class="link-arrow" href="#modulos">{o.hero.secondary}<span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="one-hero__card" aria-hidden="true">
          <img src="/img/integrade-one-negativo.svg" alt="" width="370" height="72" />
          <p class="one-hero__suite">{o.architecture.suiteLabel}</p>
          <ul class="one-hero__mods">
            {mods.map((m) => (
              <li>{m.name}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap what">
      <div>
        <p class="eyebrow">{o.what.eyebrow}</p>
        <h2 class="h2">{o.what.title}</h2>
      </div>
      <p class="what__text">{o.what.text}</p>
    </div>
    <div class="wrap mt-l">
      <ol class="rule-list">
        {o.principles.items.map((p) => (
          <li>
            <span class="rule-list__no">{p.no}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--pale" id="modulos">
    <div class="wrap">
      <SectionHead eyebrow={o.explorer.eyebrow} title={o.explorer.title} lead={o.explorer.lead} />
      <ModuleExplorer locale={locale} id="one-mx" />
      <p class="small" style="margin-top:16px">{c.modules.labels.scope}</p>
    </div>
  </section>

  <section class="section section--darker">
    <div class="wrap">
      <SectionHead eyebrow={o.architecture.eyebrow} title={o.architecture.title} stacked />
      <div class="suite">
        <div class="suite__parent">
          <span>{o.architecture.suite}</span>
          <small>{o.architecture.suiteLabel}</small>
        </div>
        <ul class="suite__peers">
          {mods.map((m) => (
            <li>
              <a href={modulePath(locale, m.slug)}>
                <strong>{m.name}</strong>
                <small>{m.descriptor}</small>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <p class="note" style="margin-top:32px">{o.architecture.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={o.lifecycle.eyebrow} title={o.lifecycle.title} stacked />
      <LifecycleExplorer locale={locale} id="one-lc" />
    </div>
  </section>

  <section class="section section--pale">
    <div class="wrap grid grid--2 apps-com">
      <article class="card">
        <p class="card__kicker">{o.apps.eyebrow}</p>
        <h3 class="apps-com__title">{o.apps.title}</h3>
        <p>{o.apps.text}</p>
        <a class="link-arrow" href={routes.apps[locale]}>{o.apps.link}<span aria-hidden="true">→</span></a>
      </article>
      <article class="card card--dark">
        <p class="card__kicker">{o.commercial.eyebrow}</p>
        <h3 class="apps-com__title">{o.commercial.title}</h3>
        <p>{o.commercial.text}</p>
        <a class="btn btn--gold" href={contactSoftware}>{o.commercial.cta}<span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <CtaBand locale={locale} need="software" />
</BaseLayout>

<style>
  .one-hero {
    position: relative;
    background: var(--navy);
    color: #cfdde8;
    padding: clamp(48px, 6vw, 88px) 0 clamp(64px, 8vw, 112px);
    overflow: hidden;
    isolation: isolate;
  }

  .one-hero::before {
    content: "";
    position: absolute;
    right: -220px;
    top: -120px;
    width: 760px;
    height: 760px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 110px rgba(255, 255, 255, 0.025), 0 0 0 220px rgba(255, 255, 255, 0.015);
    z-index: -1;
  }

  .one-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .one-hero h1 {
    color: var(--white);
    font-size: clamp(48px, 6.4vw, 96px);
  }

  .one-hero h1 :global(.serif) {
    color: var(--gold);
    display: inline-block;
    font-size: 0.82em;
    margin-top: 8px;
  }

  .one-hero .lead {
    margin-top: 28px;
  }

  .one-hero__card {
    background: var(--navy-700);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: clamp(24px, 3vw, 40px);
    box-shadow: 0 40px 80px rgba(4, 22, 41, 0.35);
  }

  .one-hero__card img {
    width: min(100%, 300px);
    height: auto;
    margin-bottom: 18px;
  }

  .one-hero__suite {
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 22px;
  }

  .one-hero__mods {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .one-hero__mods li {
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 3px solid var(--teal);
    font-size: 14px;
    font-weight: 550;
    color: var(--white);
  }

  @media (max-width: 960px) {
    .one-hero__grid {
      grid-template-columns: 1fr;
    }
  }

  .what {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
  }

  .what__text {
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 860px) {
    .what {
      grid-template-columns: 1fr;
    }
  }

  .suite__parent {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 26px 32px;
    border: 1px solid var(--teal);
    background: rgba(4, 139, 168, 0.12);
  }

  .suite__parent span {
    font-size: clamp(26px, 2.6vw, 36px);
    font-weight: 400;
    color: var(--gold);
    letter-spacing: -0.02em;
  }

  .suite__parent small {
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #cfdde8;
  }

  .suite__peers {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
    position: relative;
  }

  .suite__peers li {
    position: relative;
  }

  .suite__peers li::before {
    content: "";
    position: absolute;
    top: -28px;
    left: 50%;
    width: 1px;
    height: 28px;
    background: rgba(108, 198, 216, 0.5);
  }

  .suite__peers li:nth-child(n + 6)::before {
    top: -12px;
    height: 12px;
  }

  .suite__peers a {
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 18px 16px;
    background: var(--navy-700);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .suite__peers a:hover {
    border-color: var(--gold);
    background: var(--navy-600);
  }

  .suite__peers strong {
    color: var(--white);
    font-weight: 600;
    font-size: 16px;
  }

  .suite__peers small {
    color: #a9bfd0;
    font-size: 13px;
  }

  @media (max-width: 960px) {
    .suite__peers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .suite__peers li::before {
      display: none;
    }
  }

  .apps-com__title {
    font-size: clamp(24px, 2.2vw, 32px) !important;
    font-weight: 300 !important;
    letter-spacing: -0.03em;
  }

  .apps-com .card .btn,
  .apps-com .card .link-arrow {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
