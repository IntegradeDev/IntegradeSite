---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { locales, routes, techPath, type Locale, type TechId, type Alternates } from "../i18n/locales";
import { getCopy } from "../copy";

interface Props {
  locale: Locale;
  id: TechId;
}

const { locale, id } = Astro.props;
const c = getCopy(locale);
const L = c.techs.labels;
const F = L.fields;
const tech = c.techs.items.find((t) => t.id === id)!;
const others = c.techs.items.filter((t) => t.id !== id);
const alternates = Object.fromEntries(locales.map((l) => [l, techPath(l, id)])) as Alternates;
const identLabel = c.ui.mega.solutions.groups[1].title;
---

<BaseLayout locale={locale} alternates={alternates} title={tech.name} description={`${tech.name}: ${tech.summary} ${tech.lead}`} current="solutions">
  <PageHero
    photo="assetTag"
    locale={locale}
    eyebrow={`Integrade Solutions · ${identLabel}`}
    title={tech.name}
    lead={tech.lead}
    crumbLabel={c.ui.breadcrumb}
    crumbs={[
      { label: "Integrade", href: routes.home[locale] },
      { label: "Solutions", href: routes.solutions[locale] },
      { label: identLabel, href: routes.identification[locale] },
      { label: tech.short },
    ]}
  >
    <Fragment slot="actions">
      <a class="btn btn--gold" href="#orcamento">{L.quote}<span aria-hidden="true">↓</span></a>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="wrap tech-cols">
      <div>
        <p class="eyebrow">{L.when}</p>
        <ul class="ticks">{tech.when.map((w) => <li>{w}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">{L.criteria}</p>
        <ul class="ticks">{tech.criteria.map((w) => <li>{w}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">{L.options}</p>
        <ul class="ticks">{tech.options.map((w) => <li>{w}</li>)}</ul>
      </div>
    </div>
    {tech.caveat && (
      <div class="wrap">
        <p class="note mt-l">{tech.caveat}</p>
      </div>
    )}
  </section>

  <section class="section section--pale" id="orcamento">
    <div class="wrap quote">
      <div>
        <p class="eyebrow">{L.quote}</p>
        <h2 class="h2">{tech.name}</h2>
        <p class="lead" style="margin-top:20px">{L.quoteLead}</p>
        <p class="eyebrow" style="margin-top:48px">{L.others}</p>
        <ul class="quote__others">
          {others.map((o) => (
            <li><a href={techPath(locale, o.id as TechId)}>{o.name}<span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
      <div class="quote__form">
        <ContactForm
          locale={locale}
          needs={[
            { value: "identificacao", label: tech.name },
            { value: "orientacao", label: c.ui.form.guidance },
          ]}
          preset="identificacao"
          origin={tech.name}
          detailsOpen
        >
          <div class="form__row">
            <div class="field"><label for={`q-qty-${id}`}>{F.quantity}</label><input id={`q-qty-${id}`} name={F.quantity} placeholder={F.quantityPh} /></div>
            <div class="field"><label for={`q-surface-${id}`}>{F.surface}</label><input id={`q-surface-${id}`} name={F.surface} placeholder={F.surfacePh} /></div>
          </div>
          <div class="form__row" style="margin-top:16px">
            <div class="field"><label for={`q-env-${id}`}>{F.environment}</label><input id={`q-env-${id}`} name={F.environment} placeholder={F.environmentPh} /></div>
            <div class="field"><label for={`q-size-${id}`}>{F.size}</label><input id={`q-size-${id}`} name={F.size} /></div>
          </div>
          <div class="form__row" style="margin-top:16px">
            <div class="field"><label for={`q-custom-${id}`}>{F.customization}</label><input id={`q-custom-${id}`} name={F.customization} placeholder={F.customizationPh} /></div>
            <div class="field"><label for={`q-deadline-${id}`}>{F.deadline}</label><input id={`q-deadline-${id}`} name={F.deadline} /></div>
          </div>
          <div class="field" style="margin-top:16px"><label for={`q-delivery-${id}`}>{F.delivery}</label><input id={`q-delivery-${id}`} name={F.delivery} /></div>
        </ContactForm>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tech-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 64px);
  }

  .tech-cols > div {
    border-top: 2px solid var(--navy);
    padding-top: 24px;
  }

  @media (max-width: 860px) {
    .tech-cols {
      grid-template-columns: 1fr;
    }
  }

  .quote {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .quote__form {
    background: var(--white);
    border: 1px solid var(--line);
    padding: clamp(24px, 3vw, 40px);
  }

  .quote__others {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .quote__others a {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    color: var(--ink);
  }

  .quote__others a:hover {
    color: var(--teal-600);
  }

  @media (max-width: 900px) {
    .quote {
      grid-template-columns: 1fr;
    }
  }
</style>
