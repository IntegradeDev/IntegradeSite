---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProofBand from "../components/ProofBand.astro";
import LogoWall from "../components/LogoWall.astro";
import Photo from "../components/Photo.astro";
import CtaBand from "../components/CtaBand.astro";
import { alt, routes, type Locale } from "../i18n/locales";
import { getCopy } from "../copy";
import { contact } from "../data/company";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getCopy(locale);
const a = c.about;
const archRoutes = [routes.consulting[locale], routes.services[locale], routes.solutions[locale]];
---

<BaseLayout locale={locale} alternates={alt("about")} title={a.title} description={a.description} current="about">
  <PageHero
    eyebrow={a.hero.eyebrow}
    title={a.hero.title}
    lead={a.hero.lead}
    crumbLabel={c.ui.breadcrumb}
    crumbs={[{ label: "Integrade", href: routes.home[locale] }, { label: a.title }]}
  >
    <dl slot="aside">
      <dt>{a.hero.asideLabels.since}</dt>
      <dd>{contact.since}</dd>
      <dt>{a.hero.asideLabels.hq}</dt>
      <dd>São Paulo/SP</dd>
      <dt>{a.hero.asideLabels.reach}</dt>
      <dd>{a.hero.reach}</dd>
    </dl>
  </PageHero>

  <section class="section">
    <div class="wrap story">
      <div>
        <p class="eyebrow">{a.story.eyebrow}</p>
        <h2 class="h2">{a.story.title}</h2>
      </div>
      <div class="prose">
        {a.story.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="wrap mt-l">
      <ProofBand locale={locale} />
    </div>
  </section>

  <section class="band" aria-label={a.presence.title}>
    <Photo id="energy" locale={locale} sizes="100vw" />
    <div class="wrap band__text">
      <p class="band__quote">Integrated Expertise. <span class="serif">Intelligent Solutions.</span></p>
      <p class="band__sub">{c.ui.footer.statement}</p>
    </div>
  </section>

  <section class="section section--pale">
    <div class="wrap">
      <SectionHead eyebrow={a.architecture.eyebrow} title={a.architecture.title} stacked />
      <div class="arch" role="group" aria-label={a.architecture.eyebrow}>
        <div class="arch__corp">
          <img src="/img/integrade-logo.png" alt="Integrade" width="200" height="45" loading="lazy" />
          <p class="arch__corp-label">{a.architecture.corporate}</p>
          <p class="arch__corp-line">{a.architecture.corporateLine}</p>
        </div>
        <div class="arch__connector" aria-hidden="true"></div>
        <ul class="arch__divs">
          {a.architecture.divisions.map((d, i) => (
            <li>
              <a href={archRoutes[i]}>
                <span class="arch__brand">Integrade</span>
                <span class="arch__name">{d.name}</span>
                <span class="arch__text">{d.text}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="arch__connector arch__connector--right" aria-hidden="true"></div>
        <div class="arch__products">
          <p class="arch__products-title">{a.architecture.productsTitle}</p>
          <ul>
            {a.architecture.products.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={a.values.eyebrow} title={a.values.title} stacked />
      <div class="grid grid--4">
        {a.values.items.map((v, i) => (
          <article class="value">
            <span class="value__no">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="h3">{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap presence">
      <div>
        <p class="eyebrow">{a.presence.eyebrow}</p>
        <h2 class="h2">{a.presence.title}</h2>
        <p class="lead" style="margin-top:24px">{a.presence.text}</p>
      </div>
      <ul class="presence__regions">
        {a.presence.regions.map((reg) => (
          <li><span aria-hidden="true"></span>{reg}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={c.home.sectors.eyebrow} title={c.home.sectors.title} lead={c.home.sectors.lead} />
      <LogoWall locale={locale} compact />
      <div class="actions">
        <a class="btn btn--outline" href={routes.clients[locale]}>{c.home.sectors.cta}<span aria-hidden="true">→</span></a>
      </div>
      <div class="intl mt-l">
        <h3 class="h3">{a.international.title}</h3>
        <p>{a.international.text}</p>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .band {
    position: relative;
    height: clamp(320px, 42vw, 520px);
    overflow: hidden;
    background: var(--navy);
    display: flex;
    align-items: flex-end;
  }

  .band :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .band::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 26, 46, 0.85) 0%, rgba(8, 26, 46, 0.35) 55%, rgba(8, 26, 46, 0.1) 100%);
    z-index: 1;
  }

  .band__text {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(36px, 5vw, 64px);
  }

  .band__quote {
    font-size: clamp(30px, 4vw, 56px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--white);
    margin-bottom: 14px;
  }

  .band__quote .serif {
    color: var(--gold);
  }

  .band__sub {
    color: #cfdde8;
    font-size: 17px;
    max-width: 52ch;
    margin: 0;
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 7vw, 120px);
  }

  @media (max-width: 860px) {
    .story {
      grid-template-columns: 1fr;
    }
  }

  .arch {
    display: grid;
    justify-items: center;
  }

  .arch__corp {
    text-align: center;
    background: var(--white);
    border: 1px solid var(--line);
    padding: 36px 56px;
    min-width: min(100%, 460px);
  }

  .arch__corp img {
    height: 42px;
    width: auto;
    margin: 0 auto 16px;
  }

  .arch__corp-label {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .arch__corp-line {
    font-size: 13.5px;
    letter-spacing: 0.04em;
    color: var(--teal-600);
    margin: 0;
  }

  .arch__connector {
    width: 1px;
    height: 48px;
    background: var(--navy);
  }

  .arch__divs {
    list-style: none;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    padding-top: 32px;
  }

  .arch__divs::before {
    content: "";
    position: absolute;
    top: 0;
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 1px;
    background: var(--navy);
  }

  .arch__divs li {
    position: relative;
  }

  .arch__divs li::before {
    content: "";
    position: absolute;
    top: -32px;
    left: 50%;
    width: 1px;
    height: 32px;
    background: var(--navy);
  }

  .arch__divs a {
    display: grid;
    gap: 6px;
    text-align: center;
    padding: 32px 24px;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--teal);
    height: 100%;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .arch__divs a:hover {
    transform: translateY(-3px);
    border-color: var(--navy);
    border-top-color: var(--gold);
  }

  .arch__brand {
    font-size: 13px;
    color: var(--muted);
  }

  .arch__name {
    font-size: 30px;
    font-weight: 300;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .arch__text {
    font-size: 14.5px;
    color: var(--muted);
  }

  .arch__connector--right {
    justify-self: end;
    margin-right: calc(100% / 6);
  }

  .arch__products {
    justify-self: end;
    width: min(100%, calc(100% / 3 + 120px));
    background: var(--navy);
    color: #cfdde8;
    padding: 28px 32px;
  }

  .arch__products-title {
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }

  .arch__products ul {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .arch__products li {
    color: var(--white);
    font-size: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line-dark);
  }

  @media (max-width: 860px) {
    .arch__divs {
      grid-template-columns: 1fr;
      padding-top: 0;
      gap: 16px;
    }
    .arch__divs::before,
    .arch__divs li::before {
      display: none;
    }
    .arch__connector--right {
      justify-self: center;
      margin-right: 0;
    }
    .arch__products {
      justify-self: stretch;
      width: 100%;
    }
  }

  .value {
    border-top: 2px solid var(--navy);
    padding-top: 22px;
  }

  .value__no {
    display: block;
    font-size: 13px;
    font-weight: 650;
    color: var(--teal-600);
    margin-bottom: 18px;
  }

  .value h3 {
    margin-bottom: 10px;
  }

  .value p {
    color: var(--muted);
  }

  .presence {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .presence__regions {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--line-dark);
  }

  .presence__regions li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: 22px;
    font-weight: 300;
    color: var(--white);
  }

  .presence__regions span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 5px rgba(255, 170, 0, 0.16);
  }

  @media (max-width: 860px) {
    .presence {
      grid-template-columns: 1fr;
    }
  }

  .intl {
    border-left: 2px solid var(--gold);
    padding-left: 24px;
    max-width: 72ch;
  }

  .intl h3 {
    margin-bottom: 8px;
  }

  .intl p {
    color: var(--muted);
    margin: 0;
  }
</style>
