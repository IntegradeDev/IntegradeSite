---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProofBand from "../components/ProofBand.astro";
import LogoWall from "../components/LogoWall.astro";
import Photo from "../components/Photo.astro";
import BrandArchitecture from "../components/BrandArchitecture.astro";
import CtaBand from "../components/CtaBand.astro";
import { alt, routes, type Locale } from "../i18n/locales";
import { getCopy } from "../copy";
import { contact } from "../data/company";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getCopy(locale);
const a = c.about;
---

<BaseLayout locale={locale} alternates={alt("about")} title={a.title} description={a.description} current="about">
  <PageHero
    eyebrow={a.hero.eyebrow}
    title={a.hero.title}
    lead={a.hero.lead}
    crumbLabel={c.ui.breadcrumb}
    crumbs={[{ label: "Integrade", href: routes.home[locale] }, { label: a.title }]}
  >
    <dl slot="aside">
      <dt>{a.hero.asideLabels.since}</dt>
      <dd>{contact.since}</dd>
      <dt>{a.hero.asideLabels.hq}</dt>
      <dd>São Paulo/SP</dd>
      <dt>{a.hero.asideLabels.reach}</dt>
      <dd>{a.hero.reach}</dd>
    </dl>
  </PageHero>

  <section class="section">
    <div class="wrap story">
      <div>
        <p class="eyebrow">{a.story.eyebrow}</p>
        <h2 class="h2">{a.story.title}</h2>
      </div>
      <div class="prose">
        {a.story.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="wrap mt-l">
      <ProofBand locale={locale} />
    </div>
  </section>

  <section class="band" aria-label={a.presence.title}>
    <Photo id="energy" locale={locale} sizes="100vw" />
    <div class="wrap band__text">
      <p class="band__quote">Integrated Expertise. <span class="serif">Intelligent Solutions.</span></p>
      <p class="band__sub">{c.ui.footer.statement}</p>
    </div>
  </section>

  <section class="section section--pale">
    <div class="wrap">
      <SectionHead eyebrow={a.architecture.eyebrow} title={a.architecture.title} stacked />
      <BrandArchitecture locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={a.values.eyebrow} title={a.values.title} stacked />
      <div class="grid grid--4">
        {a.values.items.map((v, i) => (
          <article class="value">
            <span class="value__no">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="h3">{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap presence">
      <div>
        <p class="eyebrow">{a.presence.eyebrow}</p>
        <h2 class="h2">{a.presence.title}</h2>
        <p class="lead" style="margin-top:24px">{a.presence.text}</p>
      </div>
      <ul class="presence__regions">
        {a.presence.regions.map((reg) => (
          <li><span aria-hidden="true"></span>{reg}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={c.home.sectors.eyebrow} title={c.home.sectors.title} lead={c.home.sectors.lead} />
      <LogoWall locale={locale} compact />
      <div class="actions">
        <a class="btn btn--outline" href={routes.clients[locale]}>{c.home.sectors.cta}<span aria-hidden="true">→</span></a>
      </div>
      <div class="intl mt-l">
        <h3 class="h3">{a.international.title}</h3>
        <p>{a.international.text}</p>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .band {
    position: relative;
    height: clamp(320px, 42vw, 520px);
    overflow: hidden;
    background: var(--navy);
    display: flex;
    align-items: flex-end;
  }

  .band :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .band::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 26, 46, 0.85) 0%, rgba(8, 26, 46, 0.35) 55%, rgba(8, 26, 46, 0.1) 100%);
    z-index: 1;
  }

  .band__text {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(36px, 5vw, 64px);
  }

  .band__quote {
    font-size: clamp(30px, 4vw, 56px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--white);
    margin-bottom: 14px;
  }

  .band__quote .serif {
    color: var(--gold);
  }

  .band__sub {
    color: #cfdde8;
    font-size: 17px;
    max-width: 52ch;
    margin: 0;
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 7vw, 120px);
  }

  @media (max-width: 860px) {
    .story {
      grid-template-columns: 1fr;
    }
  }

  .value {
    border-top: 2px solid var(--navy);
    padding-top: 22px;
  }

  .value__no {
    display: block;
    font-size: 13px;
    font-weight: 650;
    color: var(--teal-600);
    margin-bottom: 18px;
  }

  .value h3 {
    margin-bottom: 10px;
  }

  .value p {
    color: var(--muted);
  }

  .presence {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .presence__regions {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--line-dark);
  }

  .presence__regions li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: 22px;
    font-weight: 300;
    color: var(--white);
  }

  .presence__regions span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 5px rgba(255, 170, 0, 0.16);
  }

  @media (max-width: 860px) {
    .presence {
      grid-template-columns: 1fr;
    }
  }

  .intl {
    border-left: 2px solid var(--gold);
    padding-left: 24px;
    max-width: 72ch;
  }

  .intl h3 {
    margin-bottom: 8px;
  }

  .intl p {
    color: var(--muted);
    margin: 0;
  }
</style>
