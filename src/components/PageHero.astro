---
import Photo from "./Photo.astro";
import type { Locale } from "../i18n/locales";
import type { PhotoId } from "../data/photos";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  title?: string;
  titleHtml?: string;
  lead?: string;
  crumbs?: Crumb[];
  crumbLabel?: string;
  photo?: PhotoId;
  locale?: Locale;
}

const { eyebrow, title, titleHtml, lead, crumbs = [], crumbLabel = "Breadcrumb", photo, locale = "pt-br" } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<section class:list={["page-hero", { "page-hero--photo": !!photo }]}>
  {photo && (
    <div class="page-hero__media" aria-hidden="false">
      <Photo id={photo} locale={locale} eager sizes="(max-width: 900px) 100vw, 45vw" />
    </div>
  )}
  <div class="wrap page-hero__wrap">
    {crumbs.length > 0 && (
      <nav aria-label={crumbLabel}>
        <ol class="breadcrumbs">
          {crumbs.map((c, i) => (
            <li>
              {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class:list={[{ "page-hero__grid": hasAside }]}>
      <div class="page-hero__copy">
        <p class="eyebrow">{eyebrow}</p>
        {titleHtml ? <h1 class="display" set:html={titleHtml} /> : <h1 class="display">{title}</h1>}
        {lead && <p class="lead">{lead}</p>}
        {Astro.slots.has("actions") && (
          <div class="actions">
            <slot name="actions" />
          </div>
        )}
      </div>
      {hasAside && (
        <aside class="page-hero__aside">
          <slot name="aside" />
        </aside>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero :global(.display) {
    font-size: clamp(40px, 5.6vw, 80px);
  }

  .page-hero--photo .page-hero__wrap {
    position: relative;
    z-index: 1;
  }

  .page-hero--photo .page-hero__copy {
    max-width: 52%;
  }

  .page-hero--photo :global(.display) {
    font-size: clamp(38px, 4.6vw, 68px);
  }

  .page-hero__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 46%;
    z-index: 0;
  }

  .page-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__media::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--navy) 0%, rgba(16, 45, 78, 0.55) 22%, rgba(16, 45, 78, 0.1) 60%, rgba(16, 45, 78, 0.25) 100%);
    z-index: 1;
  }

  .page-hero__media::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 120px;
    height: 4px;
    background: var(--gold);
    z-index: 2;
  }

  @media (max-width: 900px) {
    .page-hero--photo {
      padding-bottom: 0;
    }
    .page-hero--photo .page-hero__copy {
      max-width: none;
      padding-bottom: 48px;
    }
    .page-hero__media {
      position: relative;
      width: 100%;
      height: 260px;
      order: 2;
    }
    .page-hero--photo {
      display: flex;
      flex-direction: column;
    }
    .page-hero__media::before {
      background: linear-gradient(180deg, var(--navy) 0%, rgba(16, 45, 78, 0.15) 45%);
    }
  }
</style>
