---
import ModeView from "../../../../../views/ModeView.astro";
import { modeSlugs, type ModeId } from "../../../../../i18n/locales";

export function getStaticPaths() {
  return (Object.keys(modeSlugs) as ModeId[]).map((id) => ({ params: { mode: modeSlugs[id]["pt-br"] }, props: { id } }));
}

const { id } = Astro.props;
---

<ModeView locale="pt-br" id={id} />
